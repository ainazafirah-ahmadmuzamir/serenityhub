<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>SerenityHub | UTM Mental Health Literacy Hub</title>
    <link rel="stylesheet" href="assets/css/styles.css" />
  </head>
  <body>
    <!-- header -->
    <header class="header">
      <div class="container">
        <div class="header-content">
          <div class="logo">
            <div class="logo-icon">
              <img src="images/welcome.png" width="40" height="40" />
            </div>
            <div class="logo-text">
              <h1>SerenityHub</h1>
              <p class="logo-subtitle">UTM Mental Health Literacy Hub</p>
            </div>
          </div>
          <div class="header-buttons">
            <a href="signup.jsp" class="btn btn-secondary">Sign Up</a>
            <a href="login.jsp" class="btn btn-primary">Login</a>
          </div>
        </div>
      </div>
    </header>

    <!-- landing page -->
    <section class="hero">
      <div class="container">
        <div class="hero-grid">
          <div class="hero-content">
            <h1 class="hero-title">
              Take Care of Your Mental Wellbeing with SerenityHub
            </h1>
            <p class="hero-description">
              SerenityHub is UTM's integrated platform that promotes mental
              health awareness, self-care, and access to support. Break the
              stigma and start your wellness journey today.
            </p>
            <div class="hero-buttons">
              <a href="#features" class="btn btn-outline btn-large"
                >Learn More</a
              >
            </div>
          </div>
          <div class="hero-image">
            <div class="image-wrapper">
              <img src="images/landingpage.png" alt="Student mental health" />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- problem statement -->
    <section class="problem-section">
      <div class="container">
        <div class="section-header">
          <h3>Why SerenityHub?</h3>
          <p class="section-description">
            University students face increasing mental health challenges, but
            support shouldn't be difficult to access.
          </p>
        </div>
        <div class="stats-grid">
          <div class="stat-card">
            <div class="stat-number">1 in 3</div>
            <p class="stat-label">Students experience mental health issues</p>
          </div>
          <div class="stat-card">
            <div class="stat-number">60%</div>
            <p class="stat-label">Don't seek help due to stigma</p>
          </div>
          <div class="stat-card">
            <div class="stat-number">Limited</div>
            <p class="stat-label">Access to reliable resources</p>
          </div>
          <div class="stat-card">
            <div class="stat-number">Fragmented</div>
            <p class="stat-label">Support systems hinder assistance</p>
          </div>
        </div>
      </div>
    </section>

    <!-- features / module -->
    <section class="features" id="features">
      <div class="container">
        <div class="section-header">
          <h3>Comprehensive Support System</h3>
          <p class="section-description">
            Eight integrated modules designed to support your mental health
            journey
          </p>
        </div>
        <div class="features-grid">
          <div class="feature-card">
            <div class="feature-icon icon-blue">
              <svg
                width="32"
                height="32"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
                <path
                  d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"
                ></path>
              </svg>
            </div>
            <h4>Educational Resources</h4>
            <p>
              Access curated articles, videos, and guides about mental health
              awareness and self-care strategies.
            </p>
          </div>
          <div class="feature-card">
            <div class="feature-icon icon-pink">
              <svg
                width="32"
                height="32"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <path
                  d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"
                ></path>
              </svg>
            </div>
            <h4>Mood Tracking</h4>
            <p>
              Monitor your mental wellbeing with self-assessment tools and track
              your progress over time.
            </p>
          </div>
          <div class="feature-card">
            <div class="feature-icon icon-purple">
              <svg
                width="32"
                height="32"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                <circle cx="9" cy="7" r="4"></circle>
                <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
              </svg>
            </div>
            <h4>Peer Support Forum</h4>
            <p>
              Connect with fellow students in a safe, moderated community to
              share experiences and support.
            </p>
          </div>
          <div class="feature-card">
            <div class="feature-icon icon-green">
              <svg
                width="32"
                height="32"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                <line x1="16" y1="2" x2="16" y2="6"></line>
                <line x1="8" y1="2" x2="8" y2="6"></line>
                <line x1="3" y1="10" x2="21" y2="10"></line>
              </svg>
            </div>
            <h4>Counselling Requests</h4>
            <p>
              Book confidential sessions with professional counselors whenever
              you need support.
            </p>
          </div>
          <div class="feature-card">
            <div class="feature-icon icon-indigo">
              <svg
                width="32"
                height="32"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
              </svg>
            </div>
            <h4>24/7 ChatBot Support</h4>
            <p>
              Get instant guidance and resources through our AI-powered mental
              health assistant.
            </p>
          </div>
          <div class="feature-card">
            <div class="feature-icon icon-orange">
              <svg
                width="32"
                height="32"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <path
                  d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"
                ></path>
              </svg>
            </div>
            <h4>Feedback System</h4>
            <p>
              Help us improve by sharing your thoughts and suggestions about the
              platform.
            </p>
          </div>
          <div class="feature-card">
            <div class="feature-icon icon-cyan">
              <svg
                width="32"
                height="32"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <line x1="12" y1="20" x2="12" y2="10"></line>
                <line x1="18" y1="20" x2="18" y2="4"></line>
                <line x1="6" y1="20" x2="6" y2="16"></line>
              </svg>
            </div>
            <h4>Analytics Dashboard</h4>
            <p>
              For administrators to monitor platform usage and identify trends
              in student mental health.
            </p>
          </div>
          <div class="feature-card">
            <div class="feature-icon icon-teal">
              <svg
                width="32"
                height="32"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <path
                  d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"
                ></path>
                <circle cx="9" cy="10" r="1"></circle>
                <circle cx="15" cy="10" r="1"></circle>
                <path d="M9 14h6"></path>
              </svg>
            </div>
            <h4>Anonymous Support</h4>
            <p>
              Access resources and support without fear of stigma or judgment.
            </p>
          </div>
        </div>
      </div>
    </section>
  </body>
</html>
